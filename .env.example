# Copy this to .env and fill in all values before running docker compose
# NEVER commit .env

# Single-user identity for the Torro web UI
APP_USERNAME=admin

# Recovery password (FALLBACK for when you don't have a passkey, and used to
# enroll your FIRST passkey on first run). Primary login is passkeys (WebAuthn).
# Generate the bcrypt hash with Node.js:
#   node -e "const b=require('bcryptjs'); console.log(b.hashSync('yourpassword',12))"
RECOVERY_PASSWORD_HASH=replace_with_bcrypt_hash_of_your_password

# qBittorrent internal credentials (not exposed publicly)
QBIT_USERNAME=admin
QBIT_PASSWORD=replace_with_qbittorrent_webui_password

# Jackett API key for torrent search (generated by install.sh). Leave blank to
# disable the Search feature. Add indexers (e.g. YTS) in the Jackett UI.
JACKETT_API_KEY=

# WebAuthn relying-party id — must equal the domain users visit (no scheme/port).
# Leave blank to default to DOMAIN. Use "localhost" for local testing.
RP_ID=

# Production: your public origin, e.g. https://yourdomain.com
# Leave empty for local testing.
ALLOWED_ORIGIN=

# Production only (docker-compose.prod.yml)
DOMAIN=yourdomain.com
ACME_EMAIL=you@yourdomain.com

# DockerHub username or org (e.g. johndoe or myorg)
DOCKER_REPO=yourname
# Image version to deploy — use 'latest' or a specific tag e.g. 0.1.0
TORRO_VERSION=latest
